te":"exact_retained_card_literal_no_new_assessment","field_name":"named_theory_or_construct","literal_id":"3417007764bd8c1b7906b403221e4261191dc720df516fe0e841d7b3943aadce","source_card_sha256":"b5f95c24fdb79fb30df03fdeba7df53559db5d9f5d514ee3556854258b76e195","source_locator":"/lineage_graph/source_nodes/7/named_theory_or_construct"},"s2:S2R8O-DCAF5953B989E051":{"evidence_state":"exact_retained_card_literal_no_new_assessment","field_name":"named_theory_or_construct","literal_id":"9491ac8e8b0fdf756ea2cdd112ab4b702fb327bf2aa9951d17b8f5e5b787e20f","source_card_sha256":"b5f95c24fdb79fb30df03fdeba7df53559db5d9f5d514ee3556854258b76e195","source_locator":"/lineage_graph/source_nodes/5/named_theory_or_construct"},"s2:S2R8O-DE3AE33491486C33":{"evidence_state":"exact_retained_card_literal_no_new_assessment","field_name":"named_theory_or_construct","literal_id":"1cb611c7bcbfeda9f8e158e78d831ad93a600ec9d75ed9482efc9577b68e5e98","source_card_sha256":"b5f95c24fdb79fb30df03fdeba7df53559db5d9f5d514ee3556854258b76e195","source_locator":"/lineage_graph/source_nodes/1/named_theory_or_construct"},"s2:S2R8O-E011EED084268D82":{"evidence_state":"exact_retained_card_literal_no_new_assessment","field_name":"named_theory_or_construct","literal_id":"000f11c92651515033f6833311d73774e8637f04de215f97cf9955eabcf5db29","source_card_sha256":"b5f95c24fdb79fb30df03fdeba7df53559db5d9f5d514ee3556854258b76e195","source_locator":"/lineage_graph/source_nodes/13/named_theory_or_construct"},"s2:S2R8O-EB4FEA47340971CD":{"evidence_state":"exact_retained_card_literal_no_new_assessment","field_name":"named_theory_or_construct","literal_id":"82cbd4790675ac3987c889c60688dd06710035ee7794e16c4c7b5b71cd3cc66f","source_card_sha256":"b5f95c24fdb79fb30df03fdeba7df53559db5d9f5d514ee3556854258b76e195","source_locator":"/lineage_graph/source_nodes/3/named_theory_or_construct"}},"literals":{"01c6656b7c5f3f7b7f5e6ea76d3ba279711610d979679d8b540645fb4b081c5f":"the finding that some high-performing students use bottom-out hints strategically as worked examples, cited against the paper's own label of these behaviours as unproductive","1c7898ae7a3fee5fa6d135b0c36853b954d337a9ab18c7f2b3985d7b5ce9c92b":"Van de Pol, Volman and Beishuizen's six scaffolding strategies, feeding back, hints, instructing, explaining, modeling and questioning, written into the system prompt as the menu the model selects from each turn","b25d9cf564ce3cad61721ff96d59cbf2e5e6738daa32795ba317582621468998":"scaffolding, fading, and transfer of responsibility","1e42addd388f5107d113ba7ab28a4f3c36d9ee8799a623af8c007a48fd039d08":"teacher dashboards summarising student-LLM interaction, cited as existing only for asynchronous settings and therefore not covering the real-time case","a8f4490cbd76750f16e4a77147ce6d2b4c6a656d4dc7210d74e9ebfab728a4bc":"the assistance dilemma, the question of how much help to give and when, used to frame the bottom-out hint as a structural misalignment with productive struggle","38ca037be60dbdb44178236775612b70f6a865a44763919983325ff63042f82f":"the dialogue-act taxonomy used to classify user utterances into statements, information requests, answers and acceptances, which is what makes the shift in who is doing the work visible","31f445f74717c4aaa6d154c104dc6c36f56736d40cbd0f4e4c4a55dcccd73e92":"cyclic interaction models and the objection that display-based models cannot account for error-free use of an interface with hidden modes; supplies the cycle and the argument for including history and state","1cb611c7bcbfeda9f8e158e78d831ad93a600ec9d75ed9482efc9577b68e5e98":"the technology probe, the methodological frame for deploying an unfinished system in a real classroom to surface design opportunities rather than to prove efficacy","b10ee40db25fbef378c7ab53c3fdec7502c93bb45a689169b38195a0bc99ab3b":"the finding that indirect manipulation of an 8 puzzle produced deeper planning and fewer moves than direct manipulation, attributed by its authors to directness and reattributed here to resource representation","2b29ec687f75dca28bbe4ee3d83ae6fff9779ff076e661252ac694b59da32953":"Adaptive interfaces","76b62b07fdd136a8429d2ad822fa76f13032547d68a2374a9366f2b30c0a1abb":"distributed cognition","3abfcfd718f437ce8a834c9f76673200dd5d795b1fbf0d2e53ad005bdcc8479a":"person-plus and executive function in distributed cognition","f889e532251fba07a006433970a1b5834f3c04084f575bd569eb9cd251fba2c0":"reflection-in-action as the deeper purpose of design feedback, which frames the whole paper's move from answer-giving to reasoning support","9491ac8e8b0fdf756ea2cdd112ab4b702fb327bf2aa9951d17b8f5e5b787e20f":"the single cited warrant that LLMs detect grammatical errors accurately, on which the automated correctness grading of student sentences rests","a77e97d19224cf33132736cf30968677c1a7d74cb3d2f04e216bdd09fe08eb3e":"ARCS model of motivation","3a45cc9e0a73fc1d46c0c650811fcb5bac302e5b6cf9db16f463e20a84f61d7f":"Cognitive load theory","cdecea950ea5a10fe4583ebbc8fe4e7dc57eecaa190a26b7ff167d5648462f3f":"effects with versus effects of technology and internalization of tool-supported processes","70b9bc4db4bc222fdd14e009c71b550f920aadde1b6b852ddd379354381f7091":"interactive scaffolds for reflection on feedback, the nearest prior system in the same venue and the design tradition this work extends to language models","fcdd8c8309045ba7f11783d517c3405621be8b26b3d369ea7d07300aa08b29c9":"Bloom's taxonomy, used after the fact to read the delegation split as high performers giving away Remembering and Understanding while low performers give away Applying and Creating","31c5d413443562e95cb389a1d4fba55b7c5db5b4a0646c1e340a9954248485ab":"plans as resources for action rather than control structures that are executed, which is the pivot the whole model turns on and the source of its central failure distinction between resourcing and driving","b088f54767a62f4e679908ee43e92c34e4db72f80c0b716b5c81ddbdb241eeee":"perceived affordance, the paper's central analytic move, used to argue that the persistent visibility of the hint button signals an always-available action independently of pedagogical intent","a5c0f65b78be4d1b62a5cabd91ad469ae59ed073ec64649ff90359f1713c40b9":"transfer through attention to underlying features rather than surface similarity","494cc8f0023d4dafc85f649532103aab66562bbb40b4e595b92a53ea9e789b40":"Instructional scaffolding","501f0f2facb5cdea46585b5273090a62781b8f882e74fce766e3d17583393ac5":"naturalistic observation, the method for the three unrecorded field-note sessions that carry the whole classroom-dynamics chapter","58aa4962eca7e2db01b8bd0bb1c4323ee9910f927eb2ef753450ae0b589a6172":"the account of productive help-seeking behaviour from which both unproductive indicators are derived","bcfc8d99faa828e821ce3e15de105eb0d9532c02e865d4fa16592782d45ca0b8":"the feed-up, feed-back, feed-forward loop and the task, process, self-regulation and self levels, adopted wholesale as the survey instrument","52d9bc52901ba136bef1aafca3ad468b74cf86e2377f2a21bfcd2384f197802b":"`absent`","dde1bbf02e4fb1eeaf1c04d582db794be4d907ebced22b049a3366223b5dcb55":"Novice-to-expert transitions and intermodal guidelines","91b282849276fd9900a0c71f74164b404e7dbdca8f81e0c9b18ba490e6a311ad":"Learning by doing and exploratory learning","8fa85a06d85d3d038b09382777ed60452e864dd15571fe115aef11c5ee7f5742":"representational transformation in the cockpit, in which look-up tables and speed bugs convert arithmetic into a perceptual judgement; the paper's running worked example for co-location","535b1f89998e12dd2ff5373d1be27235ee15d9c4b0c483655fe47a8ac8995f61":"relational information displays and the mapping principle, that a display should carry exactly the information a task requires and no more, with the residual left to the user","96f02eb2544d45678e511564ad4468ed8110e5b413b1c6a0bfd5d2c1f9039d2e":"distributed cognition as a network of people and artifacts, with coordination of internal and external representations as the unit of analysis; supplies the abstract-versus-representation distinction and the coordination process","d3c01f4ef6763636ee7c29ae9c3c73a7766738f31fba91b2164d6c020a1759f4":"NASA Task Load Index (NASA-TLX)","60856a5786befc481df9d7ac77ea23dfbf09bf74bfcb91edd7c9af64e42a08a7":"Korean subject ellipsis, the specific linguistic fact used to explain why the model misread student input","206eba09547382c65b122b335ae7820d4d15efc124bc97967e82d82548edc344":"the non-disclosure-of-answers norm in educational LLM research, named as the prevailing assumption this paper's findings challenge","73aad88fc84837914ff4faa940de21154d969cbad1aee5e588582265219532ff":"mindfulness","e3b3221d60da275a84a5ecce116c47bb33b7b026396f9ebe5b4f88e079ffd637":"Training-wheels interface model","ebe2a6ba761b34eb256e3aeb550337f2a15675c1bf9879447029930e6107e870":"the four-words-per-second reading rate that defines the superficial-reading indicator's threshold","01929ef3fbfbc36e75bf420af9343dd56e2b9122564c623695b82fcc65183701":"the authors' own prior EFL-writing deployment, cited for the asynchronous LLM-in-EFL baseline this study departs from and for the argument that in-class surveys would disrupt learning","3417007764bd8c1b7906b403221e4261191dc720df516fe0e841d7b3943aadce":"the case that strategic first-language use supports L2 writing, which justified allowing Korean and code-mixed input, the feature that was heavily used and that also fed the model its misreadable input","4acc7872e9efcd2cf2bb78d0808a939b81004ca35cfebca139205d0912608977":"knowledge in the head against knowledge in the world, and the cognitive engineering argument that design decisions set how much a user must remember","82cbd4790675ac3987c889c60688dd06710035ee7794e16c4c7b5b71cd3cc66f":"Jacobs et al.'s analytic writing rubric, adapted to four 5-point domains and used both to grade the assessment and to cut the three performance groups","fa289a0125234dc886bd989a9345d3e736c7eca20c9bb999df85af0deccc614e":"GOMS and task-based modelling, cited throughout as the position being displaced: a plan as an internal control structure, with the display playing no part in controlling action","5a6a506bb7b2b1b590d984081bb350b2cf84c3d749b495ddb3183fdabddb88b0":"the six methods — modeling, coaching, scaffolding, articulation, reflection and exploration — together with fading as competence develops and exploration as its culmination; quoted directly and turned into the system prompt (the paper cites the 2018 Routledge reprint of the 1989 chapter)","b1240021e211ba5ac32ca48fb11a0955d9462682c367ec07f6d59551b1241054":"the zone of proximal development, cited twice as the theoretical grounding of multi-level hints and again in the discussion, where it is read as positioning scaffolding as contingent on demonstrated effort","f91d6c3b55b7d7a6958609ba2b36a784b93f467067678cddd726bf821cda538a":"the help-seeking synthesis, which recommends keeping on-demand hints while arguing that availability is insufficient and that systems must guide when and how help is requested; also the source of the concession that help-seeking interventions change behaviour without changing domain learning","fb98f6d4c74861968dea18e92fd52be802cb87d7aaa853413c89799819f26c6e":"code-mixing as a natural and prevalent strategy among beginner EFL learners, the second warrant for the L1 input design choice","482f30d2942b1f24d172e83c7e47d2390186716de5aa887f38408cef54c8ec21":"situated cognition, supplying the requirement that tasks be contextualised in settings that make sense to learners rather than divorced from what they do","f11704289072cb111561f8905eccfa2da715e2e96d3536181a6da35a3894ace7":"the internal versus external and implicit versus explicit representation of task rules, demonstrated on Tower of Hanoi isomorphs; the template for defining abstract information structures independently of their representation","6ca7a5686ffe9a0d9c331f0dd8556cf1935c14097d06e94adf735f2634569b2e":"the knowledge-learning-instruction framework, used to say which learning processes, induction and refinement, are circumvented when a student copies a bottom-out hint","3f24aab89eeee1950182cda0cda2e109df2f0f229751fb42a89c11ecdb9e36d1":"classroom orchestration and real-time teacher analytics, the prior work behind the proposed remedy of a teacher-facing dashboard and an explicit division of labour","f476eda297d99fa9b239bb8c3f1f8436c3b7081ed9f4ba18d4a18207102800e6":"`absent` — the paper has no explicit limitations section and does not frame a limitation of the proposed methodology.","000f11c92651515033f6833311d73774e8637f04de215f97cf9955eabcf5db29":"the claim that LLMs help shy students participate, which the paper's classroom observation contradicts for the real-time setting","eff364675deaba17673945f9dc4793516377018acd52b86802a24789cc398d6e":"Task-centric interfaces"}}
